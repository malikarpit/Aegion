# Aegion Environment Configuration
# Copy to .env and fill in values

# ============================================
# Environment
# ============================================
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ============================================
# Google Cloud / Firebase
# ============================================
GOOGLE_CLOUD_PROJECT=aegion-dev
FIREBASE_PROJECT_ID=aegion-dev
GCLOUD_KEY_PATH=./secrets/gcloud-key.json

# ============================================
# Database (Future: Postgres)
# ============================================
# DATABASE_ADAPTER=firestore
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=aegion
# POSTGRES_PASSWORD=change_me_in_production
# POSTGRES_DB=aegion

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,vscode-webview://*

# ============================================
# Security
# ============================================
# JWT_SECRET=generate_a_strong_secret_here
# RATE_LIMIT_PER_MINUTE=60

# ============================================
# AI / LangGraph
# ============================================
# GOOGLE_AI_API_KEY=your_gemini_api_key
# LANGSMITH_API_KEY=optional_for_tracing
