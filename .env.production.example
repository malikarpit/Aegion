# ============================================================
# Aegion Backend — Production Environment Variables
# ============================================================
# Copy this file to .env.production (never commit that file).
# In GCP Cloud Run, inject these via Secret Manager or the
# Cloud Run --set-env-vars / --set-secrets flags.
#
# Legend:
#   [REQUIRED] Must be set — service will fail to start without it
#   [OPTIONAL] Has a safe default, but set for production hardening
#   [SECRET]   Must be stored in GCP Secret Manager, not as plain env var
# ============================================================

# ── GCP Project ──────────────────────────────────────────────────────────────
# [REQUIRED] Your GCP project ID
GCP_PROJECT_ID=aegion-prod

# [OPTIONAL] GCS bucket for artifact storage
GCS_BUCKET=aegion-artifacts

# ── Application ──────────────────────────────────────────────────────────────
# [REQUIRED] Set to "production" — enables production guards
ENVIRONMENT=production

# [OPTIONAL] Log verbosity (WARNING recommended for production)
LOG_LEVEL=WARNING

# [OPTIONAL] Set to "false" in production — enables mock-token bypass if true
AEGION_DEBUG=false

# ── Firebase Authentication ───────────────────────────────────────────────────
# [REQUIRED] Firebase project ID (usually same as GCP project)
FIREBASE_PROJECT_ID=aegion-prod

# [SECRET] Path to Firebase Admin SDK service account JSON.
# In Cloud Run, mount via Secret Manager volume instead:
#   --set-secrets=/secrets/firebase.json=firebase-admin-key:latest
FIREBASE_CREDENTIALS_PATH=/secrets/firebase.json

# ── Supabase (Phase 3 — PostgreSQL + pgvector) ───────────────────────────────
# [SECRET] Your Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# [SECRET] Supabase anon key (safe for client-side use)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5...

# [SECRET] Supabase service role key (backend only, never expose to client)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5...

# ── Security ─────────────────────────────────────────────────────────────────
# [SECRET] HMAC key for audit chain signing — generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
AUDIT_SIGNING_KEY=

# ── Neo4j / Graph (current — will migrate to Supabase pgvector in Phase 6) ──
# [OPTIONAL] Graph backend: "neo4j" | "in_memory"
GRAPH_BACKEND=neo4j

# [REQUIRED if GRAPH_BACKEND=neo4j]
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=neo4j
# [SECRET]
NEO4J_PASSWORD=

# ── Redis (rate limiting & session cache) ────────────────────────────────────
# [OPTIONAL] Omit to fall back to in-process rate limiter
REDIS_URL=redis://your-redis-host:6379

# ── Storage Mode ─────────────────────────────────────────────────────────────
# [REQUIRED] "TEAM" in production (uses Firestore/Supabase)
#            "LOCAL" for local dev (uses SQLite/in-memory)
STORAGE_MODE=TEAM

# ── Adapter Overrides (derived from STORAGE_MODE if not set) ─────────────────
# [OPTIONAL]
DATABASE_ADAPTER=firestore
AUTH_ADAPTER=firebase
EVENT_ADAPTER=inprocess

# ── LLM Providers (user-supplied, not stored here in production) ──────────────
# These are per-user keys stored encrypted in the database.
# The following are operator-level fallbacks if workspace has no keys.
# [SECRET]
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
# [OPTIONAL] GCP trace sampling ratio (0.0 = off, 1.0 = 100%)
OTEL_TRACES_SAMPLER_ARG=0.1

# ── CORS ─────────────────────────────────────────────────────────────────────
# [REQUIRED] Comma-separated list of allowed origins
# Set to your Firebase Hosting URL after deployment
ALLOWED_ORIGINS=https://aegion-prod.web.app,https://aegion.ai

# ── Cloud Run (set automatically by Cloud Run — do not set manually) ──────────
# PORT=8080   ← injected by Cloud Run at runtime
