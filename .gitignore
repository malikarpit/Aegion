# ================================================
# Aegion Project – .gitignore
# ================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
/var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ---------- Node / TypeScript ----------
node_modules/
out/
!aegion-frontend/out
*.vsix
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/cache
.pnp.*
package-lock.json

# VS Code extension test runner (downloads entire VS Code binary ~500MB)
.vscode-test/

# ---------- Environment / Secrets ----------
# Keep .env.example and .env.production.example; ignore ALL real env files
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.cert

# ---------- Testing / Coverage ----------
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
htmlcov/
.nyc_output/
junit*.xml
test-results/
test-reports/

# ---------- IDEs ----------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
.idea/
.cursor/

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
._*

# ---------- Aegion Specific ----------
aegion-backend/media/
aegion-vscode/media/
**/logs/
.aegion_diffs/
aegion-vscode/src/api/generated/
secrets/

# Runtime-generated data (council sessions, events log, local state)
aegion-backend/.aegion/
aegion-backend/.aegion_data/

# Supabase local runtime
.supabase/

# Local LLM models (can be large binaries)
/models/

# Cost tracking logs
cost_logs/

# CPU / memory profiles
*.cpuprofile
*.heapprofile

# Historical/archive docs (old phase docs, agent logs)
historical_archives/

# Runtime data stores (generated by tests/backend at runtime)
aegion-backend/data/

# ---------- Agent / AI artifacts ----------
.gemini/
.agent/
*.resolved
*.resolved.*

# ---------- Docker ----------
*.pid
docker-compose.override.yml

# ---------- Logs & Output ----------
*.log
*.log.*
**/test_output*.txt
**/compile_log*.txt

# ---------- Generated Docs ----------
**/*.pdf
**/*.html
oldwork

# ---------- Build Script (never commit) ----------
build_history.sh

# ---------- Misc ----------
tmp/
temp/
.tmp/
*.bak
*.orig
*.rej
bandit-report.json
.test_data/
**/.test_data/
.mypy_cache/
.dmypy.json
dmypy.json

# ---------- Ignored Legacy & Temporary Folders ----------
aegion-extension/
aegion-organism/
scratch/
work after 19 april/