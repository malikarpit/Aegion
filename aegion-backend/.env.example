# ============================================================
# Aegion Backend — Environment Configuration
# Copy to .env and fill in values for your deployment target.
# NEVER commit .env to version control.
# ============================================================

# ─── Core ───────────────────────────────────────────────────
AEGION_ENVIRONMENT=development        # development | staging | production
AEGION_AUDIT_SIGNING_KEY=             # REQUIRED — 32+ char random secret (use Secret Manager in prod)
AEGION_DEBUG=false                    # true only in local dev
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# ─── Storage Mode ───────────────────────────────────────────
STORAGE_MODE=LOCAL                    # LOCAL (dev) or TEAM (prod)

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=                         # PostgreSQL DSN e.g. postgresql+asyncpg://user:pass@host/db
DATABASE_ADAPTER=firestore            # sqlite | firestore | postgres (derived from STORAGE_MODE)

# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=                         # https://xyz.supabase.co
SUPABASE_ANON_KEY=                    # anon/public key
SUPABASE_SERVICE_KEY=                 # service role key (keep secret)

# ─── GCP ────────────────────────────────────────────────────
GCP_PROJECT_ID=aegion-dev
GCS_BUCKET=aegion-artifacts
GOOGLE_API_KEY=                       # Gemini API key

# ─── Neo4j (optional — used if GRAPH_BACKEND=neo4j) ─────────
GRAPH_BACKEND=memory                  # memory | neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ─── Authentication ──────────────────────────────────────────
AUTH_ADAPTER=mock                     # mock | firebase | keycloak
AEGION_AUTH_ADAPTER=firebase          # firebase | keycloak | jwt
AEGION_JWT_ISSUER=
AEGION_JWT_AUDIENCE=aegion-api
AEGION_JWT_ALGORITHM=RS256
AEGION_JWKS_URL=                      # Used with keycloak/RS256
AEGION_JWT_SECRET=                    # Used with HS256 (dev only)
AEGION_REQUIRE_TLS=true

# ─── AI Providers ────────────────────────────────────────────
AI_ADAPTER=langgraph                  # langgraph | custom
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY= (set above under GCP)
# Additional provider keys are set per-workspace via the Model Settings UI

# ─── Council Kernel / ACK ────────────────────────────────────
AEGION_STORE_BACKEND=postgres         # postgres | memory
AEGION_VAULT_KEY=                     # Secret key for encrypted vault (32+ chars)

# ─── Event Bus ───────────────────────────────────────────────
EVENT_ADAPTER=inprocess               # inprocess | kafka | file

# ─── Alerting (optional) ─────────────────────────────────────
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ─── Firebase (if AUTH_ADAPTER=firebase) ─────────────────────
# AEGION_FIREBASE_PROJECT_ID=         # Set as AEGION_ prefixed (read by pydantic-settings)
# GOOGLE_APPLICATION_CREDENTIALS=     # Path to service account JSON

# ─── Browser Automation (if used) ────────────────────────────
AEGION_BROWSER_ENGINE=                # playwright | puppeteer (leave blank to disable)
