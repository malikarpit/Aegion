{
    "name": "aegion-vscode",
    "displayName": "Aegion: Governed AI Assistant",
    "description": "A governed multi-agent AI council that turns coding decisions into lasting architectural memory. Enterprise-ready governance.",
    "version": "0.1.0",
    "publisher": "aegion",
    "license": "MIT",
    "icon": "resources/aegion-icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/aegion/aegion-vscode"
    },
    "homepage": "https://aegion.io",
    "bugs": {
        "url": "https://github.com/aegion/aegion-vscode/issues"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Machine Learning",
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "ai",
        "copilot",
        "governance",
        "code review",
        "decision tracking",
        "enterprise",
        "audit",
        "ai assistant"
    ],
    "galleryBanner": {
        "color": "#1a1a2e",
        "theme": "dark"
    },
    "badges": [
        {
            "url": "https://img.shields.io/badge/Version-0.1.0-blue",
            "href": "https://github.com/aegion/aegion-vscode/releases",
            "description": "Version"
        }
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "aegion-sidebar",
                    "title": "Aegion",
                    "icon": "resources/aegion-icon.svg"
                }
            ]
        },
        "views": {
            "aegion-sidebar": [
                {
                    "id": "aegion.views.context",
                    "name": "Context & Intent",
                    "icon": "$(comment-discussion)",
                    "contextualTitle": "Current Session"
                },
                {
                    "id": "aegion.views.proposals",
                    "name": "Proposals & Decisions",
                    "icon": "$(git-pull-request)"
                },
                {
                    "id": "aegion.views.sessions",
                    "name": "Session History",
                    "icon": "$(history)"
                },
                {
                    "id": "aegion.views.timeline",
                    "name": "Project Timeline",
                    "icon": "$(pulse)"
                },
                {
                    "id": "aegion.views.risks",
                    "name": "Risk Observatory",
                    "icon": "$(warning)"
                },
                {
                    "id": "aegion.views.costs",
                    "name": "Cost Analysis",
                    "icon": "$(credit-card)"
                },
                {
                    "id": "aegion.views.governance",
                    "name": "Governance Queue",
                    "icon": "$(law)",
                    "when": "aegion.sessionActive"
                },
                {
                    "id": "aegion.views.system",
                    "name": "System Status",
                    "icon": "$(pulse)"
                },
                {
                    "id": "aegion.views.participants",
                    "name": "Session Participants",
                    "icon": "$(organization)",
                    "when": "aegion.sessionActive"
                },
                {
                    "id": "aegion.recoveryView",
                    "name": "Session Recovery",
                    "icon": "$(history)",
                    "contextualTitle": "Recovery"
                },
                {
                    "id": "aegion.modelSettingsView",
                    "name": "Model Settings",
                    "icon": "$(settings-gear)",
                    "contextualTitle": "Models & Optimization"
                }
            ]
        },
        "walkthroughs": [
            {
                "id": "aegion.walkthrough.welcome",
                "title": "Welcome to Aegion",
                "description": "Get started with AI-Native Governance",
                "steps": [
                    {
                        "id": "connect",
                        "title": "Connect Backend",
                        "description": "Ensure the Aegion Brain is running locally or remotely.\n[Check Connection](command:aegion.openSystemHealth)",
                        "media": {
                            "image": "resources/walkthrough/connect.png",
                            "altText": "Connection Diagram"
                        }
                    },
                    {
                        "id": "role",
                        "title": "Set Your Role",
                        "description": "Are you a Developer, Architect, or Admin?\n[Set Role](command:aegion.setRole)",
                        "media": {
                            "image": "resources/walkthrough/role.png",
                            "altText": "Role Selection"
                        }
                    },
                    {
                        "id": "session",
                        "title": "Start a Session",
                        "description": "Governance happens in sessions.\n[Start Session](command:aegion.startSession)",
                        "media": {
                            "image": "resources/walkthrough/session.png",
                            "altText": "Start Session"
                        }
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "aegion.startSession",
                "title": "Aegion: Start Session"
            },
            {
                "command": "aegion.closeSession",
                "title": "Aegion: Close Session"
            },
            {
